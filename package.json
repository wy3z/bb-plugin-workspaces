{
  "name": "bb-plugin-workspaces",
  "version": "0.5.2",
  "description": "Paseo-style workspaces for BB: every thread is a workspace, and agents in it are tabs.",
  "author": {
    "name": "WYEZ",
    "url": "https://github.com/wy3z"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wy3z/bb-plugin-workspaces.git"
  },
  "homepage": "https://github.com/wy3z/bb-plugin-workspaces#readme",
  "bugs": {
    "url": "https://github.com/wy3z/bb-plugin-workspaces/issues"
  },
  "type": "module",
  "files": [
    "README.md",
    "app.css",
    "app.tsx",
    "dist",
    "lib",
    "server.ts"
  ],
  "scripts": {
    "build": "bb plugin build",
    "check": "npm run typecheck && npm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "bb": ">=0.46 <0.47",
    "bbPluginSdk": ">=0.6 <0.7"
  },
  "bb": {
    "name": "Workspaces",
    "description": "Every thread is a workspace. Agents in it, including delegated ones, show as tabs in the thread header.",
    "branding": {
      "icon": "PanelsTopLeft"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.46.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  }
